{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agentgate",
  "main": "entry.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "DEMO_SESSIONS", "class_name": "DemoSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoSession"] }],
  "observability": { "enabled": false }
}
